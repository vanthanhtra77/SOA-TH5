							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('snapshot_id', jsonData.data.id);",
									"    console.log('Created snapshot ID: ' + jsonData.data.id);",
									"}"
								],
