			"name": "1. Xác thực qua Auth Service (Port 8000)",
			"item": [
				{
					"name": "1.1 Đăng nhập lấy Token (POST /login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"    console.log('Saved token: ' + jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"student\",\n    \"password\": \"MTIzNDU2\"\n}"
						},
						"url": {
							"raw": "{{auth_url}}/login",
							"host": [
								"{{auth_url}}"
							],
							"path": [
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Kiểm tra Token với Auth Service (GET /auth)",
					"request": {
						"method": "GET",
						"header": [
