APP_NAME="Reporting Service - TH5"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=sqlite
DB_DATABASE=database/reports.sqlite

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

AUTH_SERVICE_URL=http://127.0.0.1:8000/auth
AUTH_SERVICE_TIMEOUT=5
AUTH_SERVICE_MOCK=false

PRODUCT_SERVICE_URL=http://127.0.0.1:8001/products
PRODUCT_SERVICE_TIMEOUT=5

ORDER_SERVICE_URL=http://127.0.0.1:8002/orders
ORDER_SERVICE_TIMEOUT=5
